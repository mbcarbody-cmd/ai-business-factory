{
  "updated_at": "2026-06-13",
  "owner": "MARKET-2 Warehouse Autonomy Director",
  "product": "Parts Commerce OS",
  "build_rule": "Build internal seller OS first. Do not build full marketplace until this workflow works for one seller.",
  "first_mvp_slice": "add_part -> map_category_tree -> suggest_location -> set_price_and_floor -> generate_listing_status -> reserve_or_order -> ageing_dead_stock_signal",
  "source_of_truth_files": {
    "category_tree": "OPS/marketplace/parts_category_tree.json",
    "workflow_rules": "OPS/marketplace/parts_workflow_rules.json",
    "foundation_audit": "OPS/marketplace/foundation_completeness_audit.md"
  },
  "entities": {
    "Seller": {"fields": ["id", "name", "country", "channels", "pricing_rules", "warehouse_ids", "status"]},
    "Warehouse": {"fields": ["id", "seller_id", "name", "zones", "capacity_notes", "rules"]},
    "Location": {"fields": ["id", "warehouse_id", "zone", "shelf", "box_bin", "capacity_units", "dimensions", "current_occupancy_percent", "allowed_category_ids", "allowed_storage_profiles", "blocked_category_ids", "hazard_allowed"]},
    "Vehicle": {"fields": ["id", "make", "model", "generation", "year_from", "year_to", "body", "engine", "fuel", "drive", "rhd_lhd_specific", "notes"]},
    "PartCategory": {"fields": ["category_id", "subcategory_id", "lt_name", "en_name", "aliases_lt", "storage_profile"]},
    "Part": {"fields": ["id", "seller_id", "vehicle_id", "part_number", "alt_part_numbers", "description_raw", "category_id", "subcategory_id", "storage_profile", "side", "position", "condition", "condition_grade", "photos", "no_photo_reason", "weight", "dimensions", "purchase_cost", "price", "floor_price", "pricing_confidence", "pricing_reason", "fitment_confidence", "location_id", "suggested_location_id", "fallback_location_id", "location_reason", "listing_status", "quality_warnings", "status", "liquidity_score", "ageing_action", "created_at", "updated_at"]},
    "PriceRecord": {"fields": ["id", "part_id", "source", "observed_price", "currency", "condition", "marketplace", "url", "observed_at", "confidence"]},
    "Listing": {"fields": ["id", "part_id", "title", "description", "channel", "channel_status", "quality_warnings", "published_at", "unpublished_at"]},
    "Reservation": {"fields": ["id", "part_id", "buyer_ref", "channel", "reserved_until", "status", "notes"]},
    "Order": {"fields": ["id", "reservation_id", "part_id", "price", "shipping_price", "payment_state", "pick_state", "pack_state", "ship_state", "return_state", "margin"]},
    "DemandSignal": {"fields": ["id", "part_id", "source", "signal_type", "strength", "notes", "created_at"]},
    "CompetitorPrice": {"fields": ["id", "part_id", "competitor", "price", "currency", "url", "last_checked", "confidence"]}
  },
  "workflow_steps": [
    {"step": 1, "name": "Add part", "input": ["part_number_or_clear_description", "vehicle", "condition", "photos_or_no_photo_reason"], "output": ["Part draft"], "decision": "block if no part identifier/description or no condition"},
    {"step": 2, "name": "Map category tree", "input": ["description_raw", "part_number", "category tree aliases"], "output": ["category_id", "subcategory_id", "storage_profile"], "decision": "block if no category_id; manual review if ambiguous"},
    {"step": 3, "name": "Suggest location", "input": ["storage_profile", "dimensions", "weight", "allowed_category_ids", "allowed_storage_profiles", "occupancy"], "output": ["suggested_location_id", "fallback_location_id", "location_reason"], "decision": "if no location fits -> pending_location_queue"},
    {"step": 4, "name": "Set price and floor", "input": ["part_number", "category_id", "condition_grade", "competitor prices", "liquidity score", "purchase cost"], "output": ["price", "floor_price", "pricing_confidence", "pricing_reason"], "decision": "if rare/no comps/high value -> manual review"},
    {"step": 5, "name": "Generate listing status", "input": ["photos", "title", "description", "price", "category_id", "location"], "output": ["ready_to_publish", "needs_photo", "needs_data", "manual_pricing_review", "hold"], "decision": "block if missing title/price/category/photo without exception"},
    {"step": 6, "name": "Reserve/order", "input": ["buyer_ref", "channel", "price", "shipping"], "output": ["reservation/order state"], "decision": "reservation expires or becomes paid order"},
    {"step": 7, "name": "Ageing and dead-stock risk", "input": ["days_in_stock", "views", "inquiries", "price_changes", "liquidity_score"], "output": ["keep", "discount", "promote", "bundle", "review", "clearance"], "decision": "low liquidity goes to action queue"}
  ],
  "first_demo_kpis": ["parts_without_location", "locations_over_85_percent", "ready_to_publish_count", "manual_pricing_review_count", "reserved_parts", "dead_stock_risk_count", "pending_location_count", "missing_category_count"],
  "gate_to_build": ["category tree exists", "workflow rules exist", "data model uses category_id/subcategory_id", "first workflow accepted", "CFO value case exists", "competitor gap checked", "internal dry-run selected"]
}
