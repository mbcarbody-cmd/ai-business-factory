{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(python3 scripts/ops_audit.py*)",
      "Bash(python scripts/ops_audit.py*)",
      "Bash(ls*)",
      "Bash(cat OPS/*)",
      "Bash(find OPS -maxdepth 3 -type f*)"
    ],
    "ask": [
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(npm install*)",
      "Bash(pip install*)",
      "Bash(curl*)",
      "Bash(wget*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./config/credentials.json)",
      "Read(./**/*secret*)",
      "Read(./**/*token*)",
      "Bash(rm -rf*)",
      "Bash(sudo*)",
      "Bash(chmod 777*)",
      "Bash(chown*)",
      "Bash(docker*)",
      "Bash(kubectl*)",
      "Bash(terraform apply*)",
      "Bash(git push origin main*)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": false,
    "filesystem": {
      "denyRead": ["./.env", "./.env.*", "./secrets", "~/.ssh", "~/.aws", "~/.config/gcloud"],
      "denyWrite": ["/", "/etc", "/usr", "/var", "~/.ssh", "~/.aws", "~/.config/gcloud"]
    }
  }
}