# Copy to runtime/.env on the server. Never commit the real .env file.
POSTGRES_DB=revenue
POSTGRES_USER=revenue
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM

RUNTIME_DOMAIN=api.example.com
PUBLIC_BASE_URL=https://api.example.com
ADMIN_TOKEN=CHANGE_ME_LONG_RANDOM

# Safe defaults: system runs, but does not send outreach and does not process jobs.
KILL_SWITCH=true
OUTREACH_MODE=draft
DAILY_SEND_CAP=10
NIGHTLY_HOUR_UTC=1
WORKER_POLL_SECONDS=10

# OpenAI-compatible model endpoint.
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4.1-mini
MODEL_API_KEY=

# Payment provider. Bank account details belong inside the provider dashboard, not here.
PAYMENT_LINK_URL=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Separate authenticated business mailbox only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

LOG_LEVEL=INFO
