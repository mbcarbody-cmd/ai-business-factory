# Copy to runtime/.env on the server. Never commit real values.
APP_ENV=production
PUBLIC_BASE_URL=https://your-domain.example
ADMIN_TOKEN=change-this-long-random-token
KILL_SWITCH=false
DAILY_AI_BUDGET_EUR=10
DAILY_OUTREACH_LIMIT=20
OFFER_PRICE_EUR=249

# n8n
N8N_HOST=your-domain.example
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://your-domain.example/
N8N_ENCRYPTION_KEY=change-this-32-plus-char-secret

# Payment provider. Use one provider first.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_LINK=
PAYPAL_WEBHOOK_ID=
WISE_PROFILE_ID=
REVOLUT_BUSINESS_TOKEN=

# AI providers. Put real keys only on the server.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=

# Approved sending mailbox only, not private inbox.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=offers@your-domain.example
SMTP_PASSWORD=
SMTP_FROM=offers@your-domain.example
REPLY_TO=offers@your-domain.example
